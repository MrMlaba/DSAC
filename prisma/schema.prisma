// DSAC Public Entity & NPO Reporting and Oversight Platform
// Prototype schema — GovTech Hackathon 2026. Synthetic data only.
//
// Design rule: one source of truth. Approved budget = the sum of an entity's BudgetLines;
// actual expenditure = the sum of QuarterlyExpenditure rows; performance = KpiMilestone targets
// vs PerformanceReport actuals; compliance = Report due dates vs submissions. Every dashboard,
// tab and portfolio roll-up is derived from these rows (see src/lib/calc and src/lib/data/metrics.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EntityType {
  PUBLIC_ENTITY
  NPO
}

enum Sector {
  SPORT
  ARTS
  CULTURE
  HERITAGE
  MUSEUMS
  LIBRARIES
  ARCHIVES
  OTHER
}

enum Role {
  DSAC_ADMIN
  DSAC_ANALYST
  ENTITY_ADMIN
  ENTITY_CONTRIBUTOR
  EXECUTIVE_VIEWER
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4
  ANNUAL
}

/// Standard expense lines every entity budgets against.
enum ExpenseCategory {
  EMPLOYEE_COSTS
  PROGRAMME_COSTS
  TRAVEL
  ADMINISTRATION
  PROFESSIONAL_FEES
  CAPITAL_EXPENDITURE
  OTHER
}

/// SUM: counts that accumulate through the year. LATEST: rates/scores where YTD is the latest value.
enum KpiAggregation {
  SUM
  LATEST
}

enum ReportKind {
  QUARTERLY_PERFORMANCE
  QUARTERLY_FINANCIAL
  GOVERNANCE_RETURN
  ANNUAL_REPORT
}

/// Draft → Submitted → Under Review → Accepted / Returned for Correction → Finalised
enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  RETURNED
  FINALISED
}

enum RequestCategory {
  BUDGET_REQUEST
  ADDITIONAL_FUNDING
  TECHNICAL_SUPPORT
  GOVERNANCE_ASSISTANCE
  PROGRAMME_SUPPORT
  CAPACITY_BUILDING
}

/// Submitted → Under Review → Approved / Declined / More Information Required → Completed
enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DECLINED
  MORE_INFO_REQUIRED
  COMPLETED
}

enum DocumentType {
  STRATEGIC_PLAN
  APP
  OPERATIONAL_PLAN
  ANNUAL_REPORT
  QUARTERLY_REPORT
  FINANCIALS
  OTHER
}

enum ReviewStatus {
  SUBMITTED
  RECEIVED
  UNDER_REVIEW
  APPROVED
  RETURNED
}

enum TaskDirection {
  INTERNAL
  TO_DSAC
  FROM_DSAC
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TEAMS
}

enum NotificationType {
  DEADLINE_REMINDER
  SUBMISSION_RECEIVED
  REVIEW_APPROVED
  REVIEW_RETURNED
  TASK_ASSIGNED
  RISK_ALERT
  COMMENT_MENTION
  WEEKLY_BRIEFING
  REPORT_SUBMITTED
  REQUEST_UPDATE
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditOpinion {
  CLEAN
  UNQUALIFIED_WITH_FINDINGS
  QUALIFIED
  ADVERSE
  DISCLAIMER
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditFindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum RaceCategory {
  AFRICAN
  COLOURED
  INDIAN
  WHITE
  OTHER
}

enum AgeBand {
  UNDER_25
  AGE_25_34
  AGE_35_44
  AGE_45_54
  AGE_55_PLUS
}

enum DisabilityStatus {
  WITH_DISABILITY
  WITHOUT_DISABILITY
}

enum JobType {
  PERMANENT
  TEMPORARY
  YOUTH
}

enum PiiClassification {
  NONE
  AGGREGATED
  PERSONAL
  SENSITIVE
}

// ---------------------------------------------------------------------------
// Core tenancy
// ---------------------------------------------------------------------------

model Entity {
  id                  String     @id @default(cuid())
  name                String
  type                EntityType
  sector              Sector
  description         String?
  logoUrl             String?
  // Organisational profile (synthetic)
  registrationNumber  String?
  establishedYear     Int?
  province            String?
  physicalAddress     String?
  contactPerson       String?
  contactEmail        String?
  contactPhone        String?
  website             String?
  accountingAuthority String?
  mandate             String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  users          User[]
  kpis           Kpi[]
  documents      Document[]
  tasks          Task[]
  budgetLines    BudgetLine[]
  disbursements  Disbursement[]
  reports        Report[]
  requests       SupportRequest[]
  auditFindings  AuditFinding[]
  workforceStats WorkforceStat[]
  jobCreations   JobCreation[]
  comments       Comment[]
  riskScores     RiskScore[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([type])
  @@index([sector])
}

model FinancialYear {
  id        String   @id @default(cuid())
  label     String   @unique // e.g. "2023/24"
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  reportingPeriods ReportingPeriod[]
  kpis             Kpi[]
  budgetLines      BudgetLine[]
  disbursements    Disbursement[]
  reports          Report[]
  requests         SupportRequest[]
  auditFindings    AuditFinding[]
  workforceStats   WorkforceStat[]
  jobCreations     JobCreation[]
}

model ReportingPeriod {
  id              String        @id @default(cuid())
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  quarter         Quarter
  startDate       DateTime
  endDate         DateTime
  dueDate         DateTime

  kpiMilestones      KpiMilestone[]
  performanceReports PerformanceReport[]
  reports            Report[]
  documents          Document[]

  @@unique([financialYearId, quarter])
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String?
  image          String?
  role           Role
  entityId       String?
  entity         Entity?  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  isDemoUser     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documentVersions   DocumentVersion[]   @relation("DocumentVersionAuthor")
  reviewedVersions   DocumentVersion[]   @relation("DocumentVersionReviewer")
  comments           Comment[]
  tasksAssigned      Task[]              @relation("TaskAssignee")
  tasksCreated       Task[]              @relation("TaskAssigner")
  notifications      Notification[]
  performanceReports PerformanceReport[]
  reportsSubmitted   Report[]            @relation("ReportSubmitter")
  reportsReviewed    Report[]            @relation("ReportReviewer")
  requestsCreated    SupportRequest[]    @relation("RequestCreator")
  requestsDecided    SupportRequest[]    @relation("RequestDecider")
  auditLogs          AuditLog[]

  @@index([entityId])
}

// ---------------------------------------------------------------------------
// Performance: standard KPI structure (Programme → Objective → KPI)
// ---------------------------------------------------------------------------

model Kpi {
  id              String         @id @default(cuid())
  entityId        String
  entity          Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear  @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  programme       String
  objective       String
  name            String
  description     String?
  unit            String
  aggregation     KpiAggregation @default(SUM)
  annualTarget    Decimal        @db.Decimal(14, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  milestones         KpiMilestone[]
  performanceReports PerformanceReport[]
  comments           Comment[]
  riskScores         RiskScore[]
  documents          Document[]

  @@index([entityId, financialYearId])
}

/// The target for one reporting period alone (not cumulative).
model KpiMilestone {
  id                String          @id @default(cuid())
  kpiId             String
  kpi               Kpi             @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  reportingPeriodId String
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  targetValue       Decimal         @db.Decimal(14, 2)

  @@unique([kpiId, reportingPeriodId])
}

/// What the entity achieved in one reporting period alone. YTD is derived, never stored.
model PerformanceReport {
  id                  String          @id @default(cuid())
  kpiId               String
  kpi                 Kpi             @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  reportingPeriodId   String
  reportingPeriod     ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  actualValue         Decimal         @db.Decimal(14, 2)
  varianceExplanation String?
  correctiveAction    String?
  submittedById       String?
  submittedBy         User?           @relation(fields: [submittedById], references: [id])
  submittedAt         DateTime        @default(now())

  @@unique([kpiId, reportingPeriodId])
}

// ---------------------------------------------------------------------------
// Finance: approved budget → disbursed → actual expenditure
// ---------------------------------------------------------------------------

/// The approved annual budget for one expense line. Entity approved budget = sum of its lines.
model BudgetLine {
  id              String          @id @default(cuid())
  entityId        String
  entity          Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear   @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  category        ExpenseCategory
  annualBudget    Decimal         @db.Decimal(14, 2)

  expenditures QuarterlyExpenditure[]
  documents    Document[]

  @@unique([entityId, financialYearId, category])
  @@index([financialYearId])
}

/// Expenditure for ONE quarter against a budget line. Cumulative actual = sum of the quarters.
model QuarterlyExpenditure {
  id           String     @id @default(cuid())
  budgetLineId String
  budgetLine   BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  quarter      Quarter
  amount       Decimal    @db.Decimal(14, 2)
  note         String?
  recordedAt   DateTime   @default(now())

  @@unique([budgetLineId, quarter])
}

/// A tranche DSAC has actually released to the entity.
model Disbursement {
  id              String        @id @default(cuid())
  entityId        String
  entity          Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  trancheNumber   Int
  amount          Decimal       @db.Decimal(14, 2)
  disbursedAt     DateTime

  @@unique([entityId, financialYearId, trancheNumber])
  @@index([financialYearId])
}

// ---------------------------------------------------------------------------
// Reports & compliance: one row per required submission
// ---------------------------------------------------------------------------

model Report {
  id                String          @id @default(cuid())
  entityId          String
  entity            Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  financialYearId   String
  financialYear     FinancialYear   @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  reportingPeriodId String
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  kind              ReportKind
  title             String
  dueDate           DateTime
  status            ReportStatus    @default(DRAFT)
  submittedAt       DateTime?
  submittedById     String?
  submittedBy       User?           @relation("ReportSubmitter", fields: [submittedById], references: [id])
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?           @relation("ReportReviewer", fields: [reviewedById], references: [id])
  reviewComment     String?
  finalisedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  documents Document[]

  @@unique([entityId, reportingPeriodId, kind])
  @@index([entityId, financialYearId])
  @@index([status, dueDate])
}

// ---------------------------------------------------------------------------
// Budget / support requests
// ---------------------------------------------------------------------------

model SupportRequest {
  id               String          @id @default(cuid())
  entityId         String
  entity           Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  financialYearId  String?
  financialYear    FinancialYear?  @relation(fields: [financialYearId], references: [id])
  title            String
  category         RequestCategory
  amountRequested  Decimal?        @db.Decimal(14, 2)
  motivation       String
  linkedProgramme  String?
  expectedOutcome  String
  status           RequestStatus   @default(SUBMITTED)
  decisionNote     String?
  createdById      String
  createdBy        User            @relation("RequestCreator", fields: [createdById], references: [id])
  decidedById      String?
  decidedBy        User?           @relation("RequestDecider", fields: [decidedById], references: [id])
  decidedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  documents Document[]

  @@index([entityId, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit history
// ---------------------------------------------------------------------------

model AuditFinding {
  id              String             @id @default(cuid())
  entityId        String
  entity          Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear      @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  category        String
  severity        AuditSeverity
  status          AuditFindingStatus @default(OPEN)
  auditorOpinion  AuditOpinion
  description     String
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())

  @@index([entityId, financialYearId])
}

// ---------------------------------------------------------------------------
// Workforce (aggregated only — no individual employee records, per POPIA)
// ---------------------------------------------------------------------------

model WorkforceStat {
  id                String            @id @default(cuid())
  entityId          String
  entity            Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  financialYearId   String
  financialYear     FinancialYear     @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  gender            Gender
  raceCategory      RaceCategory
  ageBand           AgeBand
  disabilityStatus  DisabilityStatus
  headcount         Int
  piiClassification PiiClassification @default(AGGREGATED)

  @@unique([entityId, financialYearId, gender, raceCategory, ageBand, disabilityStatus])
}

model JobCreation {
  id              String        @id @default(cuid())
  entityId        String
  entity          Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  jobType         JobType
  count           Int

  @@unique([entityId, financialYearId, jobType])
}

// ---------------------------------------------------------------------------
// Supporting documents (evidence) — linked to the KPI / budget line / report / request they support
// ---------------------------------------------------------------------------

model Document {
  id                String           @id @default(cuid())
  entityId          String
  entity            Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  reportingPeriodId String?
  reportingPeriod   ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id])
  kpiId             String?
  kpi               Kpi?             @relation(fields: [kpiId], references: [id], onDelete: SetNull)
  budgetLineId      String?
  budgetLine        BudgetLine?      @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  reportId          String?
  report            Report?          @relation(fields: [reportId], references: [id], onDelete: SetNull)
  requestId         String?
  request           SupportRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  type              DocumentType
  title             String
  retentionUntil    DateTime?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())

  versions DocumentVersion[]
  comments Comment[]

  @@index([entityId, type])
  @@index([kpiId])
  @@index([budgetLineId])
  @@index([reportId])
  @@index([requestId])
}

model DocumentVersion {
  id            String       @id @default(cuid())
  documentId    String
  document      Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  storageKey    String
  checksum      String
  fileSize      Int
  mimeType      String
  authorId      String
  author        User         @relation("DocumentVersionAuthor", fields: [authorId], references: [id])
  changeNote    String?
  reviewStatus  ReviewStatus @default(SUBMITTED)
  reviewedById  String?
  reviewedBy    User?        @relation("DocumentVersionReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String?
  aiSummary     String?
  aiFlags       Json?
  createdAt     DateTime     @default(now())

  comments Comment[]

  @@unique([documentId, versionNumber])
}

// ---------------------------------------------------------------------------
// Collaboration (parked — not surfaced in the spec's navigation)
// ---------------------------------------------------------------------------

model Comment {
  id                String           @id @default(cuid())
  entityId          String
  entity            Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  authorId          String
  author            User             @relation(fields: [authorId], references: [id])
  documentId        String?
  document          Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionId String?
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  kpiId             String?
  kpi               Kpi?             @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  taskId            String?
  task              Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parentId          String?
  parent            Comment?         @relation("CommentThread", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies           Comment[]        @relation("CommentThread")
  body              String
  mentionedUserIds  String[]
  resolved          Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([entityId])
  @@index([documentId])
  @@index([taskId])
}

model Task {
  id          String        @id @default(cuid())
  entityId    String
  entity      Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assigneeId  String
  assignee    User          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignerId  String
  assigner    User          @relation("TaskAssigner", fields: [assignerId], references: [id])
  direction   TaskDirection
  status      TaskStatus    @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  comments Comment[]

  @@index([entityId, status])
}

// ---------------------------------------------------------------------------
// Notifications & risk
// ---------------------------------------------------------------------------

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId  String?
  entity    Entity?             @relation(fields: [entityId], references: [id])
  channel   NotificationChannel
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([userId, read])
}

model RiskScore {
  id         String   @id @default(cuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  kpiId      String?
  kpi        Kpi?     @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  score      Int
  band       RiskBand
  factors    Json
  computedAt DateTime @default(now())

  @@index([entityId, computedAt])
}

// ---------------------------------------------------------------------------
// Audit log (append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  entityId   String?
  entity     Entity?  @relation(fields: [entityId], references: [id])
  action     String
  targetType String
  targetId   String?
  ipAddress  String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([userId])
  @@index([createdAt])
}
