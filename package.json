  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
