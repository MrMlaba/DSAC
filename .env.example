# Copy this file to .env and fill in real values for anything you have.
# Nothing here is required to run the demo — every integration falls back to
# a deterministic mock when its config is missing, so the app never breaks
# mid-demo. See README.md for what's mocked vs. real.

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://dsac:dsac_dev_password@localhost:5434/dsac_pe_platform"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="dev-only-secret-change-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Microsoft Entra ID (optional). If unset, only the demo credentials login
# with one-click role switching is available — which is the primary path
# for the hackathon demo anyway.
MICROSOFT_ENTRA_ID_CLIENT_ID=""
MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_TENANT_ID=""

# --- File storage (S3-compatible / MinIO locally) --------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="dsac_minio"
S3_SECRET_ACCESS_KEY="dsac_minio_password"
S3_BUCKET="dsac-documents"
S3_FORCE_PATH_STYLE="true"

# --- Microsoft Graph integration layer (optional; mocked when unset) -------
# Needed only for real SharePoint/OneDrive file access, calendar sync and
# Teams notifications. Scopes documented in src/lib/microsoft/README.md.
MICROSOFT_GRAPH_CLIENT_ID=""
MICROSOFT_GRAPH_CLIENT_SECRET=""
MICROSOFT_GRAPH_TENANT_ID=""
TEAMS_WEBHOOK_URL=""

# --- Email (Mailpit locally) -----------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="DSAC Reporting Platform <no-reply@dsac.gov.za>"

# --- AI (Anthropic Claude) --------------------------------------------------
# Deterministic mock responses are used for summaries, document analysis and
# "ask the data" when this is unset, so the demo never depends on a live key.
ANTHROPIC_API_KEY=""

# --- Early warning thresholds (days before due date) ------------------------
DEADLINE_ALERT_DAYS="30,15"
DEADLINE_ALERT_HOURLY_WITHIN_HOURS="24"

# --- Misc --------------------------------------------------------------
NODE_ENV="development"
